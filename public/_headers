/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Content-Signal: search=yes, ai-input=yes, ai-train=yes

/
  Link: </llms.txt>; rel="describedby"; type="text/markdown"
  Link: </sitemap-index.xml>; rel="sitemap"; type="application/xml"
  Link: </blog/topology/>; rel="help"
  Link: </blog/book/>; rel="canonical-source"
  Link: <https://github.com/watmin>; rel="author"
  Link: </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json"

/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=300

# API Catalog per RFC 9727 — honest minimal entry: no JSON/REST API, but the
# catalog points agents at our documentation surface (llms.txt + topology).
/.well-known/api-catalog
  Content-Type: application/linkset+json; charset=utf-8
  Cache-Control: public, max-age=300

# OAuth 2.0 Authorization Server Metadata per RFC 8414 — explicit "no auth"
# document: empty response_types_supported + grant_types_supported. Beats a
# 404 because it tells agents unambiguously that we have no OAuth, no
# protected resources, and points them at llms.txt instead.
/.well-known/oauth-authorization-server
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300

# OAuth 2.0 Protected Resource Metadata per RFC 9728 — companion to the
# authorization-server doc. Empty authorization_servers + scopes_supported
# arrays signal "no protected resources" explicitly.
/.well-known/oauth-protected-resource
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300

# MCP Server Card per SEP-1649 (draft) — explicit "no server" stub: empty
# capabilities, no transport field, x-no-server: true. Strict MCP clients
# requiring transport bail (same outcome as a 404 from their side); every
# other agent gets a clearer signal that "no MCP server here" is intentional.
/.well-known/mcp/server-card.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300

# Markdown companions — every blog HTML page also has a /blog/<slug>.md served
# as the original markdown source. Set the right content-type so agents that
# fetch the .md URL or honor the alternate link get markdown back.
/blog/*.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=300

/blog/*
  Link: </llms.txt>; rel="describedby"; type="text/markdown"
  Link: </sitemap-index.xml>; rel="sitemap"; type="application/xml"
  Link: </blog/topology/>; rel="help"

/blog/topology/
  Link: </blog/topology.md>; rel="alternate"; type="text/markdown"; title="Source markdown"
  Link: </llms.txt>; rel="describedby"; type="text/markdown"
  Link: </blog/book/>; rel="next"; title="The Book (trunk)"

/blog/book/
  Link: </blog/book.md>; rel="alternate"; type="text/markdown"; title="Source markdown"
  Link: </llms.txt>; rel="describedby"; type="text/markdown"
  Link: </blog/arc-170-cliffnotes/>; rel="related"; title="Arc 170 — Cliff Notes (branch)"
  Link: </blog/arc-170-realizations/>; rel="related"; title="Arc 170 — Full Realizations (branch)"
  Link: </blog/topology/>; rel="up"; title="The Topology"

/blog/arc-170-realizations/
  Link: </blog/arc-170-realizations.md>; rel="alternate"; type="text/markdown"; title="Source markdown"
  Link: </blog/arc-170-cliffnotes/>; rel="describedby"; title="Cliff Notes (load first)"
  Link: </blog/book/>; rel="up"; title="The Book (trunk)"
  Link: </blog/topology/>; rel="help"; title="The Topology"

/blog/arc-170-cliffnotes/
  Link: </blog/arc-170-cliffnotes.md>; rel="alternate"; type="text/markdown"; title="Source markdown"
  Link: </blog/arc-170-realizations/>; rel="canonical"; title="Full Realizations"
  Link: </blog/book/>; rel="up"; title="The Book (trunk)"
  Link: </blog/topology/>; rel="help"; title="The Topology"

# Story posts and primers — Cloudflare Pages supports glob-with-path matching.
# Each route gets an alternate-link pointing at the .md companion at the same slug.
/blog/story/*/
  Link: </llms.txt>; rel="describedby"; type="text/markdown"
  Link: </blog/topology/>; rel="help"

/blog/primers/*/
  Link: </llms.txt>; rel="describedby"; type="text/markdown"
  Link: </blog/topology/>; rel="help"
