---
// Gallery — a masonry grid over a native <dialog> lightbox. Images are served
// from R2 (see scripts/gallery-manifest.mjs); the repo carries only the URL
// manifest, never the image bytes.
//
//   <Gallery group="samurai-jack" />  → just that Incantatio's images
//   <Gallery cover />                 → one image per Incantatio (landing sheet)
//   <Gallery />                       → every image (heavy; avoid on big sets)
import manifestData from "../gallery-manifest.json";
const manifest = manifestData as Record<string, { prompt: string; images: string[] }>;

interface Props {
  group?: string;
  cover?: boolean;
}
const { group, cover } = Astro.props;

const entry = group ? manifest[group] : null;
let urls: string[];
if (group) urls = entry?.images ?? [];
else if (cover) urls = Object.values(manifest).map((e) => e.images[0]).filter(Boolean);
else urls = Object.values(manifest).flatMap((e) => e.images);
---

{
  group && entry?.prompt && (
    <pre class="incantatio-prompt">{entry.prompt}</pre>
  )
}

{
  urls.length === 0 ? (
    <p class="gallery-empty">No images yet for this Incantatio.</p>
  ) : (
    <div class="gallery">
      {urls.map((url, i) => (
        <button
          class="gallery-tile"
          data-full={url}
          aria-label={`Open image ${i + 1} of ${urls.length}`}
        >
          <img src={url} alt="" loading="lazy" decoding="async" />
        </button>
      ))}
    </div>
  )
}

<dialog class="gallery-lightbox" aria-label="Image viewer">
  <button class="gl-close" data-gl-close aria-label="Close">✕</button>
  <button class="gl-prev" data-gl-prev aria-label="Previous image">‹</button>
  <img class="gl-img" alt="" />
  <button class="gl-next" data-gl-next aria-label="Next image">›</button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(".gallery-lightbox");
  if (dialog) {
    const imgEl = dialog.querySelector<HTMLImageElement>(".gl-img")!;
    const tiles = [...document.querySelectorAll<HTMLElement>(".gallery-tile")];
    let idx = 0;

    const show = (i: number) => {
      if (tiles.length === 0) return;
      idx = (i + tiles.length) % tiles.length;
      imgEl.src = tiles[idx].dataset.full ?? "";
    };

    tiles.forEach((t, i) =>
      t.addEventListener("click", () => {
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector("[data-gl-close]")!.addEventListener("click", () => dialog.close());
    dialog.querySelector("[data-gl-prev]")!.addEventListener("click", (e) => {
      e.stopPropagation();
      show(idx - 1);
    });
    dialog.querySelector("[data-gl-next]")!.addEventListener("click", (e) => {
      e.stopPropagation();
      show(idx + 1);
    });
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(idx - 1);
      else if (e.key === "ArrowRight") show(idx + 1);
    });
  }
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
    margin: 1.5rem 0;
  }
  .gallery-tile {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    overflow: hidden;
    background: none;
    cursor: zoom-in;
    aspect-ratio: 2 / 3;
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease;
  }
  .gallery-tile:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }
  .gallery-tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery-empty {
    opacity: 0.7;
    font-style: italic;
  }

  /* The Incantatio's verbatim prompt. The WHOLE prompt is shown — long lines
     flow to fit the box width, paragraph breaks preserved, no scrollbar, no
     height cap. Nothing hidden. */
  .incantatio-prompt {
    white-space: pre-wrap;
    overflow-wrap: break-word;
    overflow: visible;
    margin: 0.5rem 0 1.5rem;
    padding: 0.85rem 1rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    font-family: var(--sl-font-mono, ui-monospace, monospace);
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }

  .gallery-lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
  }
  /* Native <dialog> centering is unreliable with custom sizing — flex-center
     the image in a full-viewport modal instead. */
  .gallery-lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gallery-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(2px);
  }
  .gallery-lightbox .gl-img {
    display: block;
    max-width: 92vw;
    max-height: 92vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
  }
  .gl-close,
  .gl-prev,
  .gl-next {
    position: fixed;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }
  .gl-close:hover,
  .gl-prev:hover,
  .gl-next:hover {
    background: rgba(0, 0, 0, 0.75);
  }
  .gl-close {
    top: 1rem;
    right: 1rem;
  }
  .gl-prev {
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .gl-next {
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
</style>
